---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { all, photo, contact, COLLECTION_URL, PRODUCT_URL, type Shot } from '../data/catalog';
import meta from '../data/gallery-meta.json';

/**
 * Hero "stage". Until the brand film is shot, the stage plays the exhibits as an animated sequence.
 * To switch to video, set heroVideo to the file in /public/video (mp4, muted loop) — the overlay stays the same.
 */
const heroVideo = '';

type Slide = { shot: Shot; word: string; no: string; title: string; materials: string; price: string };
const slides: Slide[] = [
  { shot: 'red-51', word: 'Romance', no: '051', title: 'Bouquet of 51 Red Roses', materials: '51 red roses, 60 cm · satin ribbon', price: 'AED 595' },
  { shot: 'fuchsia-basket', word: 'Joy', no: '031', title: 'Fuchsia Plume Basket', materials: 'Garden roses, gerberas, feathers', price: 'AED 750' },
  { shot: 'golden-noel', word: 'Noël', no: '115', title: 'Golden Noel', materials: 'Noble fir, dried orange, cones', price: 'AED 580' },
  { shot: 'lemon-basket', word: 'Sunshine', no: '024', title: 'Lemon Garden Basket', materials: 'Spray roses, lisianthus, anthurium', price: 'AED 690' },
  { shot: 'red-101', word: 'Forever', no: '101', title: 'Bouquet of 101 Red Roses', materials: '101 red roses, 60 cm · satin ribbon', price: 'AED 1,095' },
];
// vertical centre of the giant word: a little below the top of each bouquet
const wordY = (s: Shot) => Math.min(0.46, (meta as Record<string, { bbox: number[] }>)[s].bbox[1] + 0.1);

const ticker = ['Fresh every morning', 'Turbo delivery in 40–80 min', 'Free delivery over AED 400', 'Hand-tied on Bluewaters Island'];
const occasions = [
  { t: 'Love & Romance', d: 'Red roses, blush garden roses', shot: 'red-101' as Shot },
  { t: 'Birthday', d: 'Bright baskets and bouquets', shot: 'fuchsia-basket' as Shot },
  { t: 'Thank you', d: 'Soft, sunny compositions', shot: 'lemon-basket' as Shot },
  { t: 'Anniversary', d: '51 to 555 roses', shot: 'red-51' as Shot },
  { t: 'Winter holidays', d: 'Fir, candles, gold', shot: 'golden-noel' as Shot },
  { t: 'Just because', d: 'Hatboxes and small gestures', shot: 'winter-candles' as Shot },
];
const statement = 'Every bouquet is hand-tied in our boutique on Bluewaters Island on the morning it leaves us, then carried across Dubai — often within the hour.';
---
<Layout title="FloBerry Boutique — Fresh flowers delivered in Dubai">
  <!-- 1. Stage: full-screen hero -->
  <section class="stage" id="stage" aria-label="Featured arrangements">
    {heroVideo ? (
      <video class="stage-video" src={heroVideo} poster={photo('red-51', '2400')} autoplay muted loop playsinline></video>
    ) : (
      <div class="slides">
        {slides.map((s, i) => (
          <figure class:list={['slide', { on: i === 0 }]} data-i={i} style={`--wy:${wordY(s.shot)};--len:${[...s.word].length}`}>
            <div class="frame"><div class="plate">
              <picture>
                <source media="(max-width: 760px)" {...(i === 0 ? { srcset: photo(s.shot, '1400') } : { 'data-srcset': photo(s.shot, '1400') })} />
                <img class="bg" {...(i === 0 ? { src: photo(s.shot, '2400'), fetchpriority: 'high' } : { 'data-src': photo(s.shot, '2400') })} alt="" width="2400" height="1600" />
              </picture>
              {/* two copies of the word: "difference" inverts the photo under the letters, "saturation" with a neutral grey strips the hue, so the word reads light over flowers and dark over the wall */}
              {['inv', 'sat'].map((m) => <span class={`word w-${m}`} aria-hidden="true"><span class="word-in">{[...s.word].map((ch, k) => <span class="ch" style={`--k:${k}`}>{ch}</span>)}</span></span>)}
            </div></div>
          </figure>
        ))}
      </div>
    )}

    <div class="stage-ui container">
      <div class="intro">
        <span class="eyebrow">Flower boutique · Bluewaters, Dubai</span>
        <h1 class="intro-title">Only fresh flowers.<br />Every day.</h1>
        <div class="intro-ctas">
          <a class="btn btn-primary btn-xl" href={COLLECTION_URL}>Shop the collection</a>
          <a class="btn btn-whatsapp btn-xl" href={contact.whatsapp}><Icon name="whatsapp" size={18} />WhatsApp</a>
        </div>
      </div>

      <div class="exhibit-label glass" aria-live="polite">
        <span class="lbl-top"><span>Now showing</span><span class="lbl-no">No. <b id="lbl-no">{slides[0].no}</b></span></span>
        <a class="lbl-title" id="lbl-title" href={PRODUCT_URL}>{slides[0].title}</a>
        <span class="lbl-mat" id="lbl-mat">{slides[0].materials}</span>
        <span class="lbl-row"><b id="lbl-price">{slides[0].price}</b><a href={PRODUCT_URL} class="link-caps">View piece <Icon name="arrow-right-01" size={14} /></a></span>
      </div>

      <div class="stage-nav">
        <span class="count"><b id="cur">01</b> / {String(slides.length).padStart(2, '0')}</span>
        <div class="segs">
          {slides.map((s, i) => <button class:list={['seg', { on: i === 0 }]} data-go={i} aria-label={`Show ${s.title}`}><span></span></button>)}
        </div>
        <button class="pause" id="pause" aria-label="Pause slideshow" aria-pressed="false"><span></span><span></span></button>
      </div>
    </div>
    <span class="scroll-cue" aria-hidden="true"><span></span>Scroll</span>
  </section>

  <!-- 2. Ticker -->
  <div class="ticker" aria-label="Why FloBerry">
    <div class="ticker-track" id="ticker">
      {[0, 1, 2].map(() => ticker.map((t) => (
        <span class="tk"><span>{t}</span><img src="/img/brand/pictogram-gold.svg" alt="" width="34" height="34" /></span>
      )))}
    </div>
  </div>

  <!-- 3. Hall: pinned horizontal gallery -->
  <section class="hall" id="hall">
    <div class="hall-pin">
      <div class="container hall-head">
        <div>
          <span class="eyebrow">Now showing · Winter 2026</span>
          <h2 class="hall-title">The collection, <em>on view</em></h2>
        </div>
        <p class="muted">Each arrangement is photographed exactly as it leaves the boutique. Pick a piece, choose its packing, add a card.</p>
      </div>
      <div class="hall-track" id="hall-track">
        {all.map((p) => (
          <article class="ex">
            <a class="ex-img" href={PRODUCT_URL} aria-label={p.title}><img src={p.img} alt={p.title} width="960" height="1200" loading="lazy" decoding="async" /></a>
            <div class="ex-label">
              <span class="ex-no">No. {p.no}</span>
              <h3 class="ex-title"><a href={PRODUCT_URL}>{p.title}</a></h3>
              <p>{p.materials}</p>
              <div class="ex-row"><b>{p.price}</b>{p.old && <s>{p.old}</s>}<button class="ex-add" aria-label={`Add ${p.title} to cart`}><Icon name="add-01" size={18} /></button></div>
            </div>
          </article>
        ))}
        <a class="ex ex-more" href={COLLECTION_URL}>
          <span class="ex-more-in"><img src="/img/brand/pictogram-gold.svg" alt="" width="56" height="56" /><span>View the full collection</span><Icon name="arrow-right-01" size={22} /></span>
        </a>
      </div>
      <div class="container hall-foot"><span class="hall-bar"><span id="hall-bar"></span></span><span class="muted hint only-desktop">Keep scrolling to walk the room</span></div>
    </div>
  </section>

  <!-- 4. Statement -->
  <section class="statement">
    <div class="container st-in">
      <img src="/img/brand/pictogram-gold.svg" alt="" width="56" height="56" />
      <p class="say" id="say">{statement.split(' ').map((w) => <span class="w">{w} </span>)}</p>
      <a class="link-caps" href="/pages/delivery/">How delivery works <Icon name="arrow-right-01" size={14} /></a>
    </div>
  </section>

  <!-- 5. Occasion index -->
  <section class="section occ-sec">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="titles"><span class="eyebrow">Curated by occasion</span><h2 class="h1">What are we celebrating?</h2></div>
      </div>
      <ul class="occ" id="occ">
        {occasions.map((o) => (
          <li data-reveal>
            <a href={COLLECTION_URL} data-peek={photo(o.shot)}>
              <span class="occ-t">{o.t}</span>
              <span class="occ-d">{o.d}</span>
              <img class="occ-thumb only-mobile" src={photo(o.shot)} alt="" width="960" height="1200" loading="lazy" />
              <span class="occ-arr"><Icon name="arrow-right-01" size={22} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="peek" id="peek" aria-hidden="true"><img alt="" width="960" height="1200" /></div>
  </section>

  <!-- 6. Turbo -->
  <section class="inset turbo pat-dark" id="turbo">
    <div class="container turbo-in">
      <div class="t-copy" data-reveal>
        <span class="eyebrow on-dark">Turbo Delivery</span>
        <div class="t-num"><span data-count="40">40</span><span class="dash">–</span><span data-count="80">80</span><span class="unit">min</span></div>
        <p class="lead">From the boutique on Bluewaters to any address in Dubai. Free delivery on orders over AED 400.</p>
        <a class="btn btn-gold btn-xl" href={COLLECTION_URL}>Order with Turbo</a>
      </div>
      <div class="route" aria-hidden="true">
        <svg viewBox="0 0 600 360" fill="none">
          <path class="route-bg" d="M40 300 C 140 300, 150 170, 260 170 S 390 60, 560 70" />
          <path class="route-line" d="M40 300 C 140 300, 150 170, 260 170 S 390 60, 560 70" pathLength="1" />
          <circle cx="40" cy="300" r="7" class="dot-a" />
          <circle cx="560" cy="70" r="9" class="dot-b" />
        </svg>
        <span class="car"><Icon name="fast-wind" size={20} /></span>
        <span class="pt pt-a">Bluewaters Island</span>
        <span class="pt pt-b">Your door</span>
      </div>
    </div>
  </section>

  <!-- 7. Details -->
  <section class="section">
    <div class="container detail">
      <figure class="d1 clip" data-reveal="fade"><span class="clip-in"><img src={photo('lemon-basket-close', '1400')} alt="Close-up of the Lemon Garden Basket" width="1400" height="933" loading="lazy" /></span></figure>
      <div class="d-copy" data-reveal>
        <span class="eyebrow">Signature baskets</span>
        <h2 class="h1">Composed like a still life</h2>
        <p class="lead">Spray roses, lisianthus, gerberas and anthurium, arranged by hand in woven and wicker baskets that stay with the recipient.</p>
        <a class="btn btn-secondary" href={COLLECTION_URL}>Shop baskets</a>
      </div>
      <figure class="d2 clip" data-reveal="fade"><span class="clip-in"><img src={photo('fuchsia-basket-close', '1400')} alt="Close-up of the Fuchsia Plume Basket" width="1400" height="933" loading="lazy" /></span></figure>
    </div>
  </section>

  <!-- 8. Finale -->
  <section class="inset finale">
    <div class="container fin-in" data-reveal>
      <h2 class="fin-title">Need something<br /><em>special?</em></h2>
      <p class="lead">Message our florists on WhatsApp or give us a call — we're happy to help.</p>
      <div class="fin-ctas">
        <a class="btn btn-whatsapp btn-xl" href={contact.whatsapp}><Icon name="whatsapp" size={18} />Chat on WhatsApp</a>
        <a class="btn btn-outline-light btn-xl" href={contact.tel}><Icon name="call" size={18} />{contact.phone}</a>
      </div>
      <div class="visit">
        <span><Icon name="location-01" size={18} />{contact.address}</span>
        <span><Icon name="clock-01" size={18} />[Opening hours]</span>
        <a href="https://maps.google.com/?q=FloBerry+Bluewaters+Dubai"><Icon name="route-01" size={18} />Get directions</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mobile = matchMedia('(max-width: 760px)');
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));

  /* ---------- Stage slideshow ---------- */
  const stage = document.getElementById('stage')!;
  const slides = [...stage.querySelectorAll<HTMLElement>('.slide')];
  const segs = [...stage.querySelectorAll<HTMLButtonElement>('.seg')];
  const info = JSON.parse(stage.dataset.info || '[]');
  const lbl = { no: document.getElementById('lbl-no')!, title: document.getElementById('lbl-title')!, mat: document.getElementById('lbl-mat')!, price: document.getElementById('lbl-price')!, cur: document.getElementById('cur')! };
  const label = stage.querySelector<HTMLElement>('.exhibit-label')!;
  const DURATION = 6500;
  let cur = 0, timer = 0, paused = reduce;

  const hydrate = (el: HTMLElement) => el.querySelectorAll<HTMLElement>('[data-src],[data-srcset]').forEach((n) => {
    if (n.dataset.srcset) { n.setAttribute('srcset', n.dataset.srcset); delete n.dataset.srcset; }
    if (n.dataset.src) { (n as HTMLImageElement).src = n.dataset.src; delete n.dataset.src; }
  });
  // load the remaining exhibits once the first one is on screen
  const first = slides[0]?.querySelector<HTMLImageElement>('img.bg');
  const loadRest = () => slides.slice(1).forEach(hydrate);
  if (first?.complete) setTimeout(loadRest, 300); else first?.addEventListener('load', () => setTimeout(loadRest, 300), { once: true });

  function go(n: number) {
    if (!slides.length) return;
    const next = (n + slides.length) % slides.length;
    if (next === cur && slides[cur].classList.contains('on')) { restart(); return; }
    hydrate(slides[next]);
    slides[cur].classList.remove('on'); slides[cur].classList.add('off');
    const prev = slides[cur]; setTimeout(() => prev.classList.remove('off'), 1400);
    slides[next].classList.add('on');
    segs.forEach((s, i) => { s.classList.toggle('on', i === next); s.classList.toggle('done', i < next); });
    cur = next;
    const d = info[cur];
    label.classList.add('swap');
    setTimeout(() => {
      lbl.no.textContent = d.no; lbl.title.textContent = d.title; lbl.mat.textContent = d.materials; lbl.price.textContent = d.price;
      lbl.cur.textContent = String(cur + 1).padStart(2, '0');
      label.classList.remove('swap');
    }, 380);
    restart();
  }
  function restart() {
    clearTimeout(timer);
    stage.style.setProperty('--dur', DURATION + 'ms');
    segs.forEach((s) => { s.classList.remove('run'); void s.offsetWidth; });
    if (!paused) { segs[cur]?.classList.add('run'); timer = window.setTimeout(() => go(cur + 1), DURATION); }
  }
  segs.forEach((s) => s.addEventListener('click', () => go(Number(s.dataset.go))));
  const pauseBtn = document.getElementById('pause')!;
  const setPaused = (v: boolean) => { paused = v; pauseBtn.setAttribute('aria-pressed', String(v)); pauseBtn.setAttribute('aria-label', v ? 'Play slideshow' : 'Pause slideshow'); stage.classList.toggle('paused', v); restart(); };
  pauseBtn.addEventListener('click', () => setPaused(!paused));
  document.addEventListener('visibilitychange', () => { if (document.hidden) clearTimeout(timer); else restart(); });
  // swipe on touch screens
  let sx = 0;
  stage.addEventListener('touchstart', (e) => (sx = e.touches[0].clientX), { passive: true });
  stage.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - sx; if (Math.abs(dx) > 50) go(cur + (dx < 0 ? 1 : -1)); });
  if (paused) stage.classList.add('paused');
  requestAnimationFrame(() => { stage.classList.add('ready'); restart(); });

  // depth: the giant word drifts against the pointer
  if (!reduce) stage.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse') return;
    const r = stage.getBoundingClientRect();
    stage.style.setProperty('--mx', ((e.clientX - r.left) / r.width - 0.5).toFixed(3));
    stage.style.setProperty('--my', ((e.clientY - r.top) / r.height - 0.5).toFixed(3));
  });

  /* ---------- Ticker: speeds up with scroll velocity, flips with direction ---------- */
  const tk = document.getElementById('ticker')!;
  let tx = 0, dir = 1, boost = 0, lastY = scrollY;
  const loopW = () => tk.scrollWidth / 3;

  /* ---------- Hall: pinned horizontal scroll (desktop) ---------- */
  const hall = document.getElementById('hall')!;
  const track = document.getElementById('hall-track')!;
  const bar = document.getElementById('hall-bar')!;
  let hallMax = 0;
  const sizeHall = () => {
    if (mobile.matches || reduce) { hall.style.height = ''; track.style.transform = ''; hallMax = 0; return; }
    hallMax = Math.max(0, track.scrollWidth - innerWidth + 48);
    hall.style.height = `${innerHeight + hallMax}px`;
  };
  track.addEventListener('scroll', () => { if (hallMax === 0) bar.style.width = `${(track.scrollLeft / Math.max(1, track.scrollWidth - track.clientWidth)) * 100}%`; }, { passive: true });

  /* ---------- Statement: words light up as you read ---------- */
  const say = document.getElementById('say')!;
  const words = [...say.querySelectorAll<HTMLElement>('.w')];

  /* ---------- Turbo: count-up + route draw ---------- */
  const turbo = document.getElementById('turbo')!;
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    turbo.classList.add('go'); io.disconnect();
    if (reduce) return;
    turbo.querySelectorAll<HTMLElement>('[data-count]').forEach((n) => {
      const to = Number(n.dataset.count), t0 = performance.now();
      const step = (t: number) => { const k = clamp((t - t0) / 1400); n.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 3)))); if (k < 1) requestAnimationFrame(step); };
      requestAnimationFrame(step);
    });
  }), { threshold: 0.35 });
  io.observe(turbo);

  /* ---------- Occasion index: image peeks after the cursor ---------- */
  const peek = document.getElementById('peek')!;
  const peekImg = peek.querySelector('img')!;
  let px = 0, py = 0, tx2 = 0, ty2 = 0, pv = 0;
  document.querySelectorAll<HTMLAnchorElement>('#occ a').forEach((a) => {
    a.addEventListener('pointerenter', (e) => { if (e.pointerType !== 'mouse') return; peekImg.src = a.dataset.peek!; peek.classList.add('on'); });
    a.addEventListener('pointerleave', () => peek.classList.remove('on'));
  });
  document.getElementById('occ')!.addEventListener('pointermove', (e) => { tx2 = e.clientX; ty2 = e.clientY; });

  /* ---------- one rAF loop for everything scroll-driven ---------- */
  function frame() {
    const y = scrollY, vh = innerHeight;
    // stage exit
    const sp = clamp(y / vh);
    stage.style.setProperty('--p', sp.toFixed(3));
    // ticker
    const v = y - lastY; lastY = y;
    if (v !== 0) dir = v > 0 ? 1 : -1;
    boost = boost * 0.92 + Math.min(Math.abs(v), 60) * 0.08;
    if (!reduce) { tx -= (0.6 + boost * 0.9) * dir; const w = loopW(); if (tx < -w) tx += w; if (tx > 0) tx -= w; tk.style.transform = `translate3d(${tx}px,0,0)`; }
    // hall
    if (hallMax > 0) {
      const r = hall.getBoundingClientRect();
      const k = clamp(-r.top / hallMax);
      track.style.transform = `translate3d(${-k * hallMax}px,0,0)`;
      bar.style.width = `${k * 100}%`;
    }
    // statement
    const sr = say.getBoundingClientRect();
    const sk = clamp((vh * 0.85 - sr.top) / (sr.height + vh * 0.45));
    const lit = Math.round(sk * words.length);
    words.forEach((w, i) => w.classList.toggle('lit', i < lit || reduce));
    // peek
    px += (tx2 - px) * 0.14; py += (ty2 - py) * 0.14; pv = pv * 0.85 + (tx2 - px) * 0.015;
    peek.style.transform = `translate3d(${px}px,${py}px,0) translate(-50%,-50%) rotate(${clamp(pv, -8, 8)}deg)`;
    requestAnimationFrame(frame);
  }
  sizeHall();
  addEventListener('resize', sizeHall);
  addEventListener('load', sizeHall);
  mobile.addEventListener('change', sizeHall);
  requestAnimationFrame(frame);
</script>

<script define:vars={{ info: slides.map(({ no, title, materials, price }) => ({ no, title, materials, price })) }}>
  document.getElementById('stage').dataset.info = JSON.stringify(info);
</script>

<style>
  /* ================= Stage ================= */
  .stage { position: relative; height: 100svh; min-height: 640px; margin-top: calc(-1 * var(--header-h, 190px)); overflow: hidden; background: var(--wall); color: var(--coal); --p: 0; --mx: 0; --my: 0; }
  .slides, .slide, .frame, .stage-video { position: absolute; inset: 0; }
  .stage-video { width: 100%; height: 100%; object-fit: cover; }
  .slide { opacity: 0; visibility: hidden; transition: opacity 1.3s var(--ease), visibility 0s 1.3s; }
  .slide.on { opacity: 1; visibility: visible; transition: opacity 1.3s var(--ease), visibility 0s; z-index: 2; }
  .slide.off { visibility: visible; z-index: 1; }
  .frame { transform: scale(calc(1.05 + var(--p) * 0.08)); transform-origin: 50% 60%; }
  .plate { position: absolute; inset: 0; }
  .plate picture, .plate img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .frame img { object-fit: cover; object-position: 50% 50%; }
  .slide .bg { transform: scale(1.1); transition: transform 8s cubic-bezier(.2,.6,.3,1); }
  .slide.on .bg { transform: scale(1); }
  .word { position: absolute; z-index: 2; left: 0; right: 0; top: calc(var(--wy) * 100%); text-align: center; pointer-events: none;
          transform: translate3d(calc(var(--mx) * -40px), calc(-50% + var(--my) * -24px - var(--p) * 120px), 0); }
  .word-in { display: inline-block; overflow: hidden; padding: 0 0.04em 0.06em; font-family: var(--font-display); font-weight: 400; line-height: 0.9; letter-spacing: -0.02em; color: var(--coal);
             font-size: min(21vw, calc(132vw / var(--len)), 44vh); }
  .w-inv { mix-blend-mode: difference; }
  .w-inv .word-in { color: #fff; }
  .w-sat { mix-blend-mode: saturation; }
  .w-sat .word-in { color: #808080; }
  .ch { display: inline-block; transform: translateY(105%); transition: transform 1.1s var(--ease); transition-delay: calc(var(--k) * 55ms + 250ms); }
  .slide.on .ch { transform: none; }
  .slide.off .ch { transform: translateY(-105%); transition-duration: .8s; transition-delay: calc(var(--k) * 30ms); }

  .stage-ui { position: absolute; inset: 0; z-index: 5; display: grid; grid-template-columns: minmax(0, 1fr) 340px; grid-template-rows: 1fr auto; gap: 24px 40px; padding-top: calc(var(--header-h, 190px) + 24px); padding-bottom: 40px; pointer-events: none; opacity: calc(1 - var(--p) * 1.6); }
  .stage-ui > * { pointer-events: auto; }
  .intro { grid-column: 1; grid-row: 2; display: flex; flex-direction: column; gap: 18px; align-items: flex-start; max-width: 460px; }
  .intro-title { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 44px; line-height: 1.05; text-wrap: balance; }
  .intro-ctas { display: flex; gap: 10px; flex-wrap: wrap; }
  .intro > * { animation: rise 1.1s var(--ease) both; }
  .intro > :nth-child(1) { animation-delay: .5s; } .intro > :nth-child(2) { animation-delay: .62s; } .intro > :nth-child(3) { animation-delay: .76s; }
  @keyframes rise { from { opacity: 0; transform: translateY(24px); } }

