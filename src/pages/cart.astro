---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { img, contact, PRODUCT_URL } from '../data/catalog';
const items = [
  { img: img.red51, title: 'Bouquet of 51 Red Roses', meta: ['Packing: Ribbon', 'Heart balloon (+ AED 95)', 'Card: “Happy anniversary, my love”'], unit: 740, qty: 1 },
  { img: img.white101, title: '101 White Rose Basket', meta: ['Packing: Basket'], unit: 1990, qty: 1 },
];
const upsell = [
  { icon: 'chocolate', label: 'Chocolates', price: 120 },
  { icon: 'flower', label: 'Glass vase', price: 150 },
  { icon: 'gift', label: 'Gift wrap', price: 40 },
];
const fmt = (n: number) => 'AED ' + n.toLocaleString('en-US');
---
<Layout title="Your cart — FloBerry Boutique">
  <div class="container cart">
    <div class="head"><h1 class="h1">Your cart</h1><span class="muted">2 items</span></div>
    <div class="grid">
      <div class="main">
        <div class="thead only-desktop"><span>Product</span><span>Quantity</span><span>Total</span></div>
        {items.map((it) => (
          <article class="item" data-unit={it.unit}>
            <a href={PRODUCT_URL} class="thumb"><img src={it.img} alt={it.title} width="120" height="120" /></a>
            <div class="info">
              <a href={PRODUCT_URL} class="title">{it.title}</a>
              {it.meta.map((m) => <span class="muted">{m}</span>)}
              <span class="unit">{fmt(it.unit)}</span>
            </div>
            <div class="qty">
              <div class="stepper sm"><button aria-label="Decrease" data-q="-1"><Icon name="minus-sign" size={16} /></button><output>{it.qty}</output><button aria-label="Increase" data-q="1"><Icon name="add-01" size={16} /></button></div>
              <button class="remove" aria-label="Remove"><Icon name="delete-02" size={18} /></button>
            </div>
            <strong class="line">{fmt(it.unit * it.qty)}</strong>
          </article>
        ))}

        <section class="upsell">
          <h2 class="h4">Add a little extra</h2>
          <div class="ups">
            {upsell.map((u) => (
              <div class="up"><span class="ad-ic"><Icon name={u.icon} size={22} /></span><span class="up-t"><span>{u.label}</span><span class="muted">{fmt(u.price)}</span></span><button class="icon-btn" aria-label={`Add ${u.label}`}><Icon name="add-01" size={18} /></button></div>
            ))}
          </div>
        </section>

        <label class="note"><span class="label-caps">Order note</span><textarea class="field" rows="3" placeholder="Anything we should know? Gate codes, recipient phone…"></textarea></label>
      </div>

      <aside class="summary">
        <div class="free">
          <span><Icon name="checkmark-circle-02" size={18} />You've unlocked free delivery</span>
          <span class="bar"><span></span></span>
        </div>
        <div class="slot">
          <Icon name="calendar-03" size={20} />
          <div><strong>Today, Oct 28 · 14:00 – 16:00</strong><span class="muted">Dubai Marina · Turbo available</span></div>
          <a href="#" class="link-caps">Change</a>
        </div>
        <dl>
          <div><dt>Subtotal</dt><dd id="sub">AED 2,730</dd></div>
          <div><dt>Delivery</dt><dd class="sage">Free</dd></div>
          <div class="tot"><dt>Total</dt><dd id="tot">AED 2,730</dd></div>
        </dl>
        <p class="muted vat">[VAT note to confirm]</p>
        <button class="btn btn-primary btn-xl btn-block">Checkout</button>
        <a class="btn btn-whatsapp-outline btn-block" href={contact.whatsapp}><Icon name="whatsapp" size={18} />Questions? WhatsApp us</a>
        <p class="secure muted"><Icon name="security-check" size={16} />Secure checkout · [Payment methods]</p>
      </aside>
    </div>
  </div>
</Layout>

<script>
  const fmt = (n: number) => 'AED ' + n.toLocaleString('en-US');
  const recalc = () => {
    let s = 0;
    document.querySelectorAll<HTMLElement>('.item').forEach((it) => {
      const q = Number(it.querySelector('output')!.textContent);
      const t = Number(it.dataset.unit) * q; s += t;
      it.querySelector('.line')!.textContent = fmt(t);
    });
    document.getElementById('sub')!.textContent = document.getElementById('tot')!.textContent = fmt(s);
  };
  document.querySelectorAll<HTMLElement>('[data-q]').forEach((b) => b.addEventListener('click', () => {
    const o = b.parentElement!.querySelector('output')!;
    o.textContent = String(Math.max(1, Number(o.textContent) + Number(b.dataset.q))); recalc();
  }));
  document.querySelectorAll('.remove').forEach((b) => b.addEventListener('click', () => { b.closest('.item')!.remove(); recalc(); }));
</script>

<style>
  .cart { padding-top: 32px; padding-bottom: 96px; }
  .head { display: flex; align-items: baseline; gap: 16px; margin-bottom: 32px; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) 420px; gap: 48px; align-items: start; }
  @media (min-width: 761px) { .thead { display: grid; } }
  .thead { grid-template-columns: minmax(0, 1fr) 180px 120px; padding: 0 0 14px; border-bottom: 1px solid var(--line); font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-muted); }
  .thead span:last-child { text-align: right; }
  .item { display: grid; grid-template-columns: 120px minmax(0, 1fr) 180px 120px; gap: 0 24px; align-items: center; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .thumb { border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 1; display: block; background: var(--cream); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .info { display: flex; flex-direction: column; gap: 4px; font-size: 14px; }
  .title { font-size: 17px; font-weight: 500; text-decoration: none; margin-bottom: 4px; }
  .unit { margin-top: 6px; font-weight: 500; }
  .qty { display: flex; align-items: center; gap: 8px; }
  .remove { border: 0; background: none; color: var(--ink-muted); width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  .remove:hover { background: var(--cream); color: var(--coal); }
  .line { text-align: right; font-size: 16px; }
  .upsell { margin: 40px 0 32px; display: flex; flex-direction: column; gap: 16px; }
  .ups { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .up { display: flex; align-items: center; gap: 12px; padding: 12px; border-radius: var(--radius-md); box-shadow: inset 0 0 0 1px var(--control-border); }
  .ad-ic { width: 40px; height: 40px; flex: none; border-radius: 50%; background: var(--cream); color: var(--gold-text); display: flex; align-items: center; justify-content: center; }
  .up-t { flex: 1; display: flex; flex-direction: column; font-size: 14px; font-weight: 500; }
  .up-t .muted { font-weight: 400; font-size: 13px; }
  .note { display: flex; flex-direction: column; gap: 10px; }
  .note textarea { font: inherit; font-size: 15px; padding: 14px 16px; resize: vertical; color: var(--coal); }

  .summary { position: sticky; top: 170px; background: var(--cream); border-radius: 28px; padding: 28px; display: flex; flex-direction: column; gap: 16px; }
  .free { display: flex; flex-direction: column; gap: 10px; font-size: 14px; color: var(--sage-strong); font-weight: 500; }
  .free > span:first-child { display: flex; align-items: center; gap: 8px; }
  .free .bar { height: 4px; border-radius: 2px; background: var(--line-cream); overflow: hidden; }
  .free .bar span { display: block; height: 100%; width: 100%; background: var(--sage-moss); }
  .slot { display: flex; align-items: center; gap: 12px; background: var(--surface); border-radius: var(--radius-md); padding: 14px 16px; color: var(--gold-text); }
  .slot div { flex: 1; display: flex; flex-direction: column; gap: 2px; font-size: 14px; color: var(--coal); }
  .slot .muted { font-size: 13px; }
  dl { margin: 4px 0 0; display: flex; flex-direction: column; gap: 10px; }
  dl div { display: flex; justify-content: space-between; font-size: 15px; }
  dt { color: var(--ink-secondary); }
  dd { margin: 0; font-weight: 500; }
  .sage { color: var(--sage-strong); }
  .tot { border-top: 1px solid var(--line-cream); padding-top: 14px; font-size: 20px !important; }
  .tot dt { color: var(--coal); font-weight: 600; }
  .tot dd { font-weight: 700; }
  .vat { font-size: 13px; margin: -6px 0 0; }
  .secure { display: flex; justify-content: center; align-items: center; gap: 6px; font-size: 13px; margin: 0; }

  @media (max-width: 1000px) { .grid { grid-template-columns: 1fr; } .summary { position: static; } }
  @media (max-width: 760px) {
    .cart { padding-top: 16px; padding-bottom: 56px; }
    .head { margin-bottom: 8px; }
    .item { grid-template-columns: 96px minmax(0, 1fr); grid-template-rows: auto auto; gap: 12px 14px; align-items: start; padding: 18px 0; }
    .thumb { grid-row: span 2; border-radius: 16px; }
    .title { font-size: 15px; }
    .info { font-size: 13px; }
    .unit { display: none; }
    .qty { grid-column: 2; justify-content: space-between; }
    .line { grid-column: 2; grid-row: 1; justify-self: end; display: none; }
    .ups { grid-template-columns: 1fr; }
    .summary { padding: 20px; border-radius: 24px; margin: 0 -12px; }
  }
</style>
