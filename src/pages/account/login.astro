---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import AuthShell from '../../components/AuthShell.astro';
import '../../styles/forms.css';
---
<Layout title="Sign in — FloBerry Boutique">
  <AuthShell shot="red-101" word="Welcome" no="101" title="Bouquet of 101 Red Roses" active="login">
    <form class="af" id="login" action="/account/" novalidate>
      <div class="af-head"><span class="eyebrow">Your account</span><h1>Welcome back</h1><p>Sign in to follow your orders, reorder a favourite and send flowers to saved recipients.</p></div>
      <div class="fld"><label for="email">Email</label><div class="box"><input id="email" type="email" autocomplete="email" placeholder="you@example.com" required /></div></div>
      <div class="fld"><label for="pass">Password</label><div class="box"><input id="pass" type="password" autocomplete="current-password" placeholder="Your password" required /><button type="button" class="show" data-show="pass">Show</button></div></div>
      <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
        <label class="chk" for="remember"><input id="remember" type="checkbox" checked />Keep me signed in</label>
        <a href="#" style="font-size:14px">Forgot password?</a>
      </div>
      <button class="btn btn-primary btn-xl btn-block" type="submit">Sign in</button>
      <div class="or">or</div>
      <button class="btn btn-ghost btn-xl btn-block" type="button" id="otp"><Icon name="mail-01" size={18} />Email me a one-time code</button>
      <p class="toast" id="otp-msg" hidden>Demo: on Shopify we would email a 6-digit code to this address.</p>
      <p class="alt">New to FloBerry? <a href="/account/register/">Create an account</a></p>
    </form>
  </AuthShell>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-show]').forEach((b) => b.addEventListener('click', () => {
    const i = document.getElementById(b.dataset.show!) as HTMLInputElement; const show = i.type === 'password';
    i.type = show ? 'text' : 'password'; b.textContent = show ? 'Hide' : 'Show';
  }));
  // demo: any sign-in goes to the account page
  const f = document.getElementById('login') as HTMLFormElement;
  f.addEventListener('submit', (e) => { e.preventDefault(); location.href = f.getAttribute('action')!; });
  document.getElementById('otp')!.addEventListener('click', () => { document.getElementById('otp-msg')!.hidden = false; });
</script>
