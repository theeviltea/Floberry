---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import { p, contact, COLLECTION_URL, PRODUCT_URL } from '../../data/catalog';
import '../../styles/forms.css';
// Demo customer for the preview; on Shopify these come from the customer object, orders and metafields.
const nav = [
  ['grid-view', 'Overview', 'overview'], ['package', 'Orders', 'orders'], ['location-01', 'Saved addresses', 'addresses'],
  ['calendar-03', 'Important dates', 'dates'], ['favourite', 'Wishlist', 'wishlist'], ['user', 'Profile & password', 'profile'],
];
const steps = [['Confirmed', '12:02', 2], ['Being arranged', '12:40', 2], ['Out for delivery', 'Now', 1], ['Delivered', 'by 16:00', 0]] as const;
const dates = [
  { t: 'Mum’s birthday', d: '14', m: 'Nov', in: 'in 12 days', soon: true },
  { t: 'Our anniversary', d: '2', m: 'Dec', in: 'in 30 days', soon: false },
];
const orders = [
  { n: '#FB-1042', d: 'Today', x: p.red51, tot: 'AED 740', s: 'On its way' },
  { n: '#FB-0987', d: '14 Oct 2026', x: p.lemon, tot: 'AED 690', s: 'Delivered' },
  { n: '#FB-0921', d: '2 Sep 2026', x: p.fuchsia, tot: 'AED 750', s: 'Delivered' },
];
const addrs = [
  { t: 'Home', n: 'Sara Ahmed', a: 'Marina Gate 2, Apt 1804, Dubai Marina', ph: '+971 50 123 4567', def: true },
  { t: 'Mum', n: 'Mariam Ahmed', a: 'Villa 12, Street 4, Jumeirah Village Circle', ph: '+971 55 765 4321', def: false },
];
---
<Layout title="Your account — FloBerry Boutique">
  <section class="inset band">
    <div class="container band-in">
      <div class="hi"><span class="eyebrow">Your account</span><h1 id="greet">Good afternoon, Sara</h1><p>sara.ahmed@example.com · member since March 2025</p></div>
      <div class="hi-ctas"><a class="btn btn-primary" href={COLLECTION_URL}>Send flowers again</a><a class="btn btn-whatsapp" href={contact.whatsapp}><Icon name="whatsapp" size={18} />WhatsApp a florist</a></div>
    </div>
  </section>

  <div class="container acc">
    <nav class="side" aria-label="Account">
      {nav.map(([i, l, id], k) => <a href={`#${id}`} class:list={{ on: k === 0 }}><Icon name={i} size={20} />{l}</a>)}
      <span class="sep"></span>
      <a href="/account/login/" class="out">Sign out</a>
    </nav>

    <div class="main">
      <section id="overview" class="sec" data-reveal>
        <div class="sh"><div><span class="eyebrow">On its way</span><h2>Current order</h2></div></div>
        <article class="order">
          <div class="o-top">
            <img src={p.red51.img} alt="" width="960" height="1200" />
            <div class="o-t"><span class="no">Order #FB-1042 · Today, 14:00–16:00</span><span class="o-n">{p.red51.title}</span><span class="o-m">Ribbon packing · Heart balloon · To Layla, Dubai Marina</span></div>
            <span class="st warm">On its way</span>
          </div>
          <ol class="tl" aria-label="Order progress">
            {steps.map(([t, s, st], i) => (
              <li class:list={[`s${st}`]}>
                {i < steps.length - 1 && <span class:list={['ln', { done: st === 2 }]} aria-hidden="true"></span>}
                <span class="dot">{st === 2 ? <Icon name="tick-02" size={14} weight={2} /> : st === 1 ? <Icon name="fast-wind" size={15} /> : null}</span>
                <b>{t}</b><span>{s}</span>
              </li>
            ))}
          </ol>
          <div class="o-ctas"><a class="btn btn-secondary btn-sm" href={PRODUCT_URL}>View order</a><a class="btn btn-whatsapp btn-sm" href={contact.whatsapp}><Icon name="whatsapp" size={16} />Courier on WhatsApp</a></div>
        </article>
      </section>

      <section id="dates" class="sec" data-reveal>
        <div class="sh"><div><span class="eyebrow">Never miss a moment</span><h2>Important dates</h2></div><a class="link-caps" href="#dates">Manage <Icon name="arrow-right-01" size={14} /></a></div>
        <div class="dates">
          {dates.map((d) => (
            <article class:list={['date', { soon: d.soon }]}>
              <div class="leaf"><span>{d.d}</span><small>{d.m}</small></div>
              <div class="d-t"><span>{d.t}</span><small>{d.in} · reminder by WhatsApp</small></div>
              {d.soon && <a class="btn btn-primary btn-sm" href={COLLECTION_URL}>Choose</a>}
            </article>
          ))}
          <button class="add" type="button"><Icon name="add-01" size={18} />Add a date</button>
        </div>
      </section>

      <section id="orders" class="sec" data-reveal>
        <div class="sh"><div><span class="eyebrow">History</span><h2>Your orders</h2></div><a class="link-caps" href="#orders">All orders <Icon name="arrow-right-01" size={14} /></a></div>
        <div class="tbl">
          <table>
            <thead><tr><th>Order</th><th>Date</th><th>Pieces</th><th class="r">Total</th><th>Status</th><th></th></tr></thead>
            <tbody>
              {orders.map((o) => (
                <tr>
                  <td class="b">{o.n}</td><td class="m">{o.d}</td>
                  <td><span class="pc"><img src={o.x.img} alt="" width="960" height="1200" /><span>{o.x.title}</span></span></td>
                  <td class="r b">{o.tot}</td>
                  <td><span class:list={['st', o.s === 'On its way' ? 'warm' : 'done']}>{o.s}</span></td>
                  <td class="r"><a class="re" href={PRODUCT_URL}>Reorder</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="addresses" class="sec" data-reveal>
        <div class="sh"><div><span class="eyebrow">Recipients</span><h2>Saved addresses</h2></div><a class="link-caps" href="#addresses">Add address <Icon name="arrow-right-01" size={14} /></a></div>
        <div class="addrs">
          {addrs.map((a) => (
            <article class="addr"><div class="a-h"><span>{a.t}</span>{a.def && <small>Default</small>}</div><b>{a.n}</b><p>{a.a}</p><p>{a.ph}</p><div class="a-l"><a href="#addresses">Edit</a><a href="#addresses" class="muted">Remove</a></div></article>
          ))}
        </div>
      </section>

      <section id="wishlist" class="sec" data-reveal>
        <div class="sh"><div><span class="eyebrow">Kept for later</span><h2>Wishlist</h2></div><a class="link-caps" href="#wishlist">View all <Icon name="arrow-right-01" size={14} /></a></div>
        <div class="wish"><ProductCard {...p.winter} /><ProductCard {...p.golden} /><ProductCard {...p.red101} /></div>
      </section>

      <a href="/account/login/" class="btn btn-ghost btn-block only-mobile">Sign out</a>
    </div>
  </div>
</Layout>

<script>
  const h = new Date().getHours();
  document.getElementById('greet')!.textContent = `Good ${h < 12 ? 'morning' : h < 18 ? 'afternoon' : 'evening'}, Sara`;
  // highlight the section in view
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.side a[href^="#"]')];
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    links.forEach((l) => l.classList.toggle('on', l.getAttribute('href') === '#' + e.target.id));
  }), { rootMargin: '-40% 0px -55% 0px' });
  document.querySelectorAll('.sec').forEach((s) => io.observe(s));
</script>

<style>
  .band { background: var(--wall); margin-top: 6px; }
  .band-in { padding-top: 52px; padding-bottom: 48px; display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
  .hi { display: flex; flex-direction: column; gap: 10px; }
  .hi h1 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 64px; line-height: 1; }
  .hi p { margin: 0; font-size: 15px; color: var(--ink-secondary); }
  .hi-ctas { display: flex; gap: 10px; flex-wrap: wrap; }
  .acc { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 48px; align-items: start; padding-top: 40px; padding-bottom: 96px; }
  .side { position: sticky; top: calc(var(--sticky-top) + 8px); background: var(--cream); border-radius: var(--radius-xl); padding: 14px; display: flex; flex-direction: column; gap: 4px; }
  .side a { display: flex; align-items: center; gap: 12px; height: 48px; padding: 0 16px; border-radius: 999px; text-decoration: none; font-size: 15px; color: var(--ink-secondary); transition: background-color .3s, box-shadow .3s; }
  .side a :global(svg) { color: var(--ink-muted); }
  .side a.on { background: #fff; color: var(--coal); font-weight: 600; box-shadow: 0 6px 18px rgba(34, 34, 34, .06); }
  .side a.on :global(svg) { color: var(--gold-text); }
  .sep { height: 1px; background: var(--line); margin: 10px 16px; }
  .side .out { height: 44px; color: var(--ink-muted); font-size: 14px; }
  .main { display: flex; flex-direction: column; gap: 56px; min-width: 0; }
  .sec { display: flex; flex-direction: column; gap: 20px; scroll-margin-top: calc(var(--sticky-top) + 24px); }
  .sh { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; }
  .sh > div { display: flex; flex-direction: column; gap: 6px; }
  .sh h2 { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 32px; line-height: 1.1; }
  .sh .link-caps { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; font-size: 12px; }
  .no { font-size: 11px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--gold-text); }

  .order { border: 1px solid var(--line); border-radius: var(--radius-xl); padding: 28px; display: flex; flex-direction: column; gap: 28px; box-shadow: 0 24px 60px -40px rgba(34, 34, 34, .35); }
  .o-top { display: flex; gap: 20px; align-items: center; }
  .o-top img { width: 96px; height: 120px; object-fit: cover; border-radius: 16px; background: var(--wall); flex: none; }
  .o-t { display: flex; flex-direction: column; gap: 6px; flex: 1; min-width: 0; }
  .o-n { font-family: var(--font-display); font-size: 28px; line-height: 1.1; }
  .o-m { font-size: 14px; color: var(--ink-secondary); }
  .st { padding: 7px 14px; border-radius: 999px; font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; flex: none; }
  .st.warm { background: #F3E6D8; color: var(--gold-ink); }
  .st.done { background: #E4ECE8; color: var(--sage-strong); }
  .tl { list-style: none; margin: 0; padding: 0; display: flex; }
  .tl li { position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; font-size: 12px; color: var(--ink-muted); }
  .tl li b { font-size: 13px; color: var(--coal); }
  .tl li.s0 b { color: var(--ink-muted); }
  .ln { position: absolute; top: 14px; left: calc(50% + 18px); right: calc(-50% + 18px); height: 2px; background: var(--line); }
  .ln.done { background: var(--sage-strong); }
  .dot { width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
  .s2 .dot { background: var(--sage-strong); color: #fff; }
  .s1 .dot { background: var(--coal); color: var(--light-pale-gold); box-shadow: 0 0 0 6px rgba(34, 34, 34, .1); animation: pulse 2.4s var(--ease) infinite; }
  @keyframes pulse { 50% { box-shadow: 0 0 0 10px rgba(34, 34, 34, .04); } }
  .s0 .dot { border: 1.5px dashed var(--control-border); background: #fff; }
  .o-ctas { display: flex; gap: 10px; flex-wrap: wrap; }

  .dates { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .date { display: flex; gap: 16px; align-items: center; padding: 18px; border-radius: var(--radius-lg); border: 1px solid var(--line); }
  .date.soon { background: var(--wall); }
  .leaf { width: 64px; height: 72px; border-radius: 14px; background: var(--cream); display: flex; flex-direction: column; align-items: center; justify-content: center; flex: none; }
  .leaf span { font-family: var(--font-display); font-size: 30px; line-height: 1; }
  .leaf small { font-size: 11px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }
  .soon .leaf { background: var(--coal); color: #fff; }
  .soon .leaf small { color: var(--light-pale-gold); }
  .d-t { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 0; }
  .d-t span { font-family: var(--font-display); font-size: 20px; }
  .d-t small { font-size: 13px; color: var(--ink-muted); }
  .soon .d-t small { color: var(--gold-text); font-weight: 600; }
  .add { min-height: 108px; border-radius: var(--radius-lg); border: 1.5px dashed var(--control-border); background: transparent; display: flex; align-items: center; justify-content: center; gap: 10px; font: 600 12px var(--font-sans); letter-spacing: .14em; text-transform: uppercase; color: var(--coal); cursor: pointer; transition: border-color .3s, background-color .3s; }
  .add:hover { border-color: var(--coal); background: var(--wall); }

  .tbl { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 640px; }
  th { text-align: left; padding: 0 12px 14px; font-size: 11px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-muted); }
  td { padding: 16px 12px; border-top: 1px solid var(--line); }
  .r { text-align: right; } .b { font-weight: 600; } .m { color: var(--ink-secondary); }
  td.r.b { font-variant-numeric: tabular-nums; }
  .pc { display: flex; align-items: center; gap: 12px; }
  .pc img { width: 44px; height: 55px; object-fit: cover; border-radius: 10px; }
  .pc span { font-family: var(--font-display); font-size: 17px; }
  .re { display: inline-flex; align-items: center; height: 38px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--control-border); font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; text-decoration: none; transition: background-color .3s, color .3s; }
  .re:hover { background: var(--coal); color: #fff; border-color: var(--coal); }

  .addrs { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .addr { padding: 20px; border-radius: var(--radius-lg); border: 1px solid var(--line); display: flex; flex-direction: column; gap: 6px; }
  .a-h { display: flex; justify-content: space-between; align-items: center; }
  .a-h span { font-family: var(--font-display); font-size: 20px; }
  .a-h small { font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--sage-strong); }
  .addr b { font-size: 14px; } .addr p { margin: 0; font-size: 14px; color: var(--ink-secondary); }
  .a-l { display: flex; gap: 16px; margin-top: 6px; font-size: 13px; }
  .wish { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }

  @media (max-width: 1000px) { .dates { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 760px) {
    .band-in { padding-top: 28px; padding-bottom: 22px; }
    .hi h1 { font-size: 40px; }
    .hi-ctas, .hi-ctas .btn { width: 100%; }
    .acc { grid-template-columns: 1fr; gap: 28px; padding-top: 16px; padding-bottom: 56px; }
    .side { position: static; flex-direction: row; overflow-x: auto; background: none; padding: 0; margin: 0 -20px; padding: 0 20px; scrollbar-width: none; }
    .side a { flex: none; height: 40px; background: var(--cream); font-size: 13px; }
    .side a :global(svg) { display: none; }
    .side .sep, .side .out { display: none; }
    .main { gap: 40px; }
    .sh h2 { font-size: 26px; }
    .order { padding: 20px; gap: 22px; }
    .o-top { flex-wrap: wrap; gap: 14px; }
    .o-top img { width: 72px; height: 90px; }
    .o-n { font-size: 20px; }
    .tl li { font-size: 11px; } .tl li b { font-size: 12px; }
    .dates, .addrs { grid-template-columns: 1fr; }
    .date .btn { display: none; }
    .wish { display: flex; overflow-x: auto; margin: 0 -20px; padding: 0 20px; gap: 12px; scrollbar-width: none; }
    .wish > :global(*) { flex: 0 0 62%; }
  }
</style>
