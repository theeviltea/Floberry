---
import { photo, type Shot } from '../data/catalog';
interface Props { shot: Shot; word: string; no: string; title: string; active: 'login' | 'register' }
const { shot, word, no, title, active } = Astro.props;
---
<div class="container auth">
  <div class="stage" aria-hidden="true">
    <img src={photo(shot, '1400')} alt="" width="1400" height="933" />
    <span class="w inv">{word}</span><span class="w sat">{word}</span>
    <div class="lbl glass"><span>Members · No. {no}</span><b>{title}</b></div>
  </div>
  <div class="side">
    <div class="sw" role="tablist">
      <a role="tab" href="/account/login/" aria-selected={active === 'login' ? 'true' : 'false'} class:list={{ on: active === 'login' }}>Sign in</a>
      <a role="tab" href="/account/register/" aria-selected={active === 'register' ? 'true' : 'false'} class:list={{ on: active === 'register' }}>Create account</a>
    </div>
    <slot />
  </div>
</div>

<style>
  .auth { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 72px; padding-top: 16px; padding-bottom: 96px; align-items: stretch; }
  .stage { position: relative; min-height: 640px; border-radius: var(--radius-2xl); overflow: hidden; background: var(--wall); }
  .stage img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; animation: settle 2.6s var(--ease) both; }
  @keyframes settle { from { transform: scale(1.1); } }
  .w { position: absolute; left: 0; right: 0; top: 40%; transform: translateY(-50%); text-align: center; font: 400 clamp(84px, 9vw, 132px)/.9 var(--font-display); letter-spacing: -.02em; animation: up 1.2s var(--ease) .3s both; }
  @keyframes up { from { opacity: 0; translate: 0 30px; } }
  .inv { color: #fff; mix-blend-mode: difference; }
  .sat { color: #808080; mix-blend-mode: saturation; }
  .lbl { position: absolute; left: 24px; right: 24px; bottom: 24px; border-radius: 20px; padding: 16px 20px; display: flex; flex-direction: column; gap: 4px; }
  .lbl span { font-size: 11px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--ink-muted); }
  .lbl b { font-family: var(--font-display); font-weight: 400; font-size: 22px; }
  .side { display: flex; flex-direction: column; justify-content: center; gap: 24px; padding: 40px 0; max-width: 480px; width: 100%; }
  .sw { display: inline-flex; padding: 4px; border-radius: 999px; background: var(--cream); align-self: flex-start; }
  .sw a { height: 40px; padding: 0 20px; border-radius: 999px; display: inline-flex; align-items: center; font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; text-decoration: none; transition: background-color .3s, color .3s; }
  .sw a.on { background: var(--coal); color: #fff; }
  @media (max-width: 900px) {
    .auth { grid-template-columns: 1fr; gap: 28px; padding-top: 4px; padding-bottom: 56px; }
    .stage { min-height: 0; height: 220px; margin: 0 -12px; border-radius: 24px; }
    .w { top: 50%; font-size: 84px; }
    .lbl { display: none; }
    .side { padding: 0; max-width: none; }
  }
</style>
